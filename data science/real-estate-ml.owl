<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns="http://example.org/ontologies/real-estate-ml#" xml:base="http://example.org/ontologies/real-estate-ml" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xmlns:owl="http://www.w3.org/2002/07/owl#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#">
<owl:Ontology rdf:about="http://example.org/ontologies/real-estate-ml"><rdfs:label xml:lang="uk">Онтологія класифікації об’єктів нерухомості методами машинного навчання</rdfs:label><rdfs:comment xml:lang="uk">Лабораторна робота №5. Онтологія побудована на основі таксономії з лабораторної №4: 17 концептів стали класами верхнього рівня, їхні види — підкласами, приклади — індивідами.</rdfs:comment><owl:versionInfo>1.0</owl:versionInfo></owl:Ontology>
<owl:AnnotationProperty rdf:about="#taxonomyCategory"><rdfs:label xml:lang="uk">категорія таксономії</rdfs:label></owl:AnnotationProperty>
<rdfs:Datatype rdf:about="#Quality1to10"><owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/><owl:withRestrictions rdf:parseType="Collection"><rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</xsd:minInclusive></rdf:Description><rdf:Description><xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10</xsd:maxInclusive></rdf:Description></owl:withRestrictions></rdfs:Datatype>
<rdfs:Datatype rdf:about="#Share01"><owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/><owl:withRestrictions rdf:parseType="Collection"><rdf:Description><xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0</xsd:minInclusive></rdf:Description><rdf:Description><xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1</xsd:maxInclusive></rdf:Description></owl:withRestrictions></rdfs:Datatype>
<owl:Class rdf:about="#RealEstateObject"><rdfs:label xml:lang="uk">Об’єкт нерухомості</rdfs:label><rdfs:label xml:lang="en">Real estate object</rdfs:label><rdfs:comment xml:lang="uk">Конкретний об’єкт нерухомості, який класифікується моделлю.</rdfs:comment><taxonomyCategory xml:lang="uk">Об’єкти та ринок нерухомості</taxonomyCategory></owl:Class>
<owl:Class rdf:about="#ObjectCharacteristic"><rdfs:label xml:lang="uk">Характеристика об’єкта</rdfs:label><rdfs:label xml:lang="en">Object characteristic</rdfs:label><rdfs:comment xml:lang="uk">Ознака об’єкта, що використовується моделлю як вхідна змінна.</rdfs:comment><taxonomyCategory xml:lang="uk">Об’єкти та ринок нерухомості</taxonomyCategory></owl:Class>
<owl:Class rdf:about="#Location"><rdfs:label xml:lang="uk">Локація</rdfs:label><rdfs:label xml:lang="en">Location</rdfs:label><rdfs:comment xml:lang="uk">Місце розташування об’єкта.</rdfs:comment><taxonomyCategory xml:lang="uk">Об’єкти та ринок нерухомості</taxonomyCategory></owl:Class>
<owl:Class rdf:about="#MarketPrice"><rdfs:label xml:lang="uk">Ринкова ціна</rdfs:label><rdfs:label xml:lang="en">Market price</rdfs:label><rdfs:comment xml:lang="uk">Цінова характеристика об’єкта, зокрема ціновий сегмент.</rdfs:comment><taxonomyCategory xml:lang="uk">Об’єкти та ринок нерухомості</taxonomyCategory></owl:Class>
<owl:Class rdf:about="#MarketParticipant"><rdfs:label xml:lang="uk">Учасник ринку</rdfs:label><rdfs:label xml:lang="en">Market participant</rdfs:label><rdfs:comment xml:lang="uk">Особа або організація, що діє на ринку нерухомості.</rdfs:comment><taxonomyCategory xml:lang="uk">Рівень рішень учасників ринку</taxonomyCategory></owl:Class>
<owl:Class rdf:about="#Decision"><rdfs:label xml:lang="uk">Рішення</rdfs:label><rdfs:label xml:lang="en">Decision</rdfs:label><rdfs:comment xml:lang="uk">Рішення учасника ринку, яке може підтримуватися моделлю.</rdfs:comment><taxonomyCategory xml:lang="uk">Рівень рішень учасників ринку</taxonomyCategory></owl:Class>
<owl:Class rdf:about="#PropertyDataset"><rdfs:label xml:lang="uk">Дані про нерухомість</rdfs:label><rdfs:label xml:lang="en">Property dataset</rdfs:label><rdfs:comment xml:lang="uk">Набір даних про об’єкти нерухомості.</rdfs:comment><taxonomyCategory xml:lang="uk">Дані</taxonomyCategory></owl:Class>
<owl:Class rdf:about="#DataPreparation"><rdfs:label xml:lang="uk">Підготовка даних та ознаки</rdfs:label><rdfs:label xml:lang="en">Data preparation</rdfs:label><rdfs:comment xml:lang="uk">Операція підготовки даних до навчання.</rdfs:comment><taxonomyCategory xml:lang="uk">Дані</taxonomyCategory></owl:Class>
<owl:Class rdf:about="#ModelingTask"><rdfs:label xml:lang="uk">Задача моделювання</rdfs:label><rdfs:label xml:lang="en">Modeling task</rdfs:label><rdfs:comment xml:lang="uk">Задача, яку розв’язує модель.</rdfs:comment><taxonomyCategory xml:lang="uk">Розробка і оцінювання моделі</taxonomyCategory></owl:Class>
<owl:Class rdf:about="#ModelType"><rdfs:label xml:lang="uk">Тип моделі</rdfs:label><rdfs:label xml:lang="en">Model type</rdfs:label><rdfs:comment xml:lang="uk">Тип моделі класифікації.</rdfs:comment><taxonomyCategory xml:lang="uk">Розробка і оцінювання моделі</taxonomyCategory></owl:Class>
<owl:Class rdf:about="#Algorithm"><rdfs:label xml:lang="uk">Алгоритм</rdfs:label><rdfs:label xml:lang="en">Algorithm</rdfs:label><rdfs:comment xml:lang="uk">Алгоритм машинного навчання.</rdfs:comment><taxonomyCategory xml:lang="uk">Розробка і оцінювання моделі</taxonomyCategory></owl:Class>
<owl:Class rdf:about="#ModelTraining"><rdfs:label xml:lang="uk">Навчання моделі</rdfs:label><rdfs:label xml:lang="en">Model training</rdfs:label><rdfs:comment xml:lang="uk">Вибірка або схема, що використовується під час навчання й перевірки.</rdfs:comment><taxonomyCategory xml:lang="uk">Розробка і оцінювання моделі</taxonomyCategory></owl:Class>
<owl:Class rdf:about="#Model"><rdfs:label xml:lang="uk">Модель</rdfs:label><rdfs:label xml:lang="en">Model</rdfs:label><rdfs:comment xml:lang="uk">Модель машинного навчання.</rdfs:comment><taxonomyCategory xml:lang="uk">Розробка і оцінювання моделі</taxonomyCategory></owl:Class>
<owl:Class rdf:about="#ModelValidation"><rdfs:label xml:lang="uk">Валідація моделі</rdfs:label><rdfs:label xml:lang="en">Model validation</rdfs:label><rdfs:comment xml:lang="uk">Засіб або результат оцінювання якості моделі.</rdfs:comment><taxonomyCategory xml:lang="uk">Розробка і оцінювання моделі</taxonomyCategory></owl:Class>
<owl:Class rdf:about="#BusinessKPI"><rdfs:label xml:lang="uk">KPI бізнесу</rdfs:label><rdfs:label xml:lang="en">Business KPI</rdfs:label><rdfs:comment xml:lang="uk">Показник результативності використання моделі в бізнесі.</rdfs:comment><taxonomyCategory xml:lang="uk">Експлуатація та супровід</taxonomyCategory></owl:Class>
<owl:Class rdf:about="#ModelMonitoring"><rdfs:label xml:lang="uk">Моніторинг моделі</rdfs:label><rdfs:label xml:lang="en">Model monitoring</rdfs:label><rdfs:comment xml:lang="uk">Контроль роботи моделі після впровадження.</rdfs:comment><taxonomyCategory xml:lang="uk">Експлуатація та супровід</taxonomyCategory></owl:Class>
<owl:Class rdf:about="#ModelDeveloper"><rdfs:label xml:lang="uk">Розробник моделі</rdfs:label><rdfs:label xml:lang="en">Model developer</rdfs:label><rdfs:comment xml:lang="uk">Фахівець, що створює модель.</rdfs:comment><taxonomyCategory xml:lang="uk">Виконавець</taxonomyCategory></owl:Class>
<owl:Class rdf:about="#Apartment"><rdfs:label xml:lang="uk">Квартира</rdfs:label><rdfs:label xml:lang="en">Apartment</rdfs:label><rdfs:subClassOf rdf:resource="#RealEstateObject"/></owl:Class>
<owl:Class rdf:about="#House"><rdfs:label xml:lang="uk">Житловий будинок</rdfs:label><rdfs:label xml:lang="en">House</rdfs:label><rdfs:subClassOf rdf:resource="#RealEstateObject"/></owl:Class>
<owl:Class rdf:about="#CommercialPremises"><rdfs:label xml:lang="uk">Комерційне приміщення</rdfs:label><rdfs:label xml:lang="en">Commercial premises</rdfs:label><rdfs:subClassOf rdf:resource="#RealEstateObject"/></owl:Class>
<owl:Class rdf:about="#LandPlot"><rdfs:label xml:lang="uk">Земельна ділянка</rdfs:label><rdfs:label xml:lang="en">Land plot</rdfs:label><rdfs:subClassOf rdf:resource="#RealEstateObject"/></owl:Class>
<owl:Class rdf:about="#AreaFeature"><rdfs:label xml:lang="uk">Ознака площі</rdfs:label><rdfs:label xml:lang="en">Area feature</rdfs:label><rdfs:subClassOf rdf:resource="#ObjectCharacteristic"/></owl:Class>
<owl:Class rdf:about="#RoomCountFeature"><rdfs:label xml:lang="uk">Ознака кількості кімнат</rdfs:label><rdfs:label xml:lang="en">Room count feature</rdfs:label><rdfs:subClassOf rdf:resource="#ObjectCharacteristic"/></owl:Class>
<owl:Class rdf:about="#QualityFeature"><rdfs:label xml:lang="uk">Ознака якості оздоблення</rdfs:label><rdfs:label xml:lang="en">Quality feature</rdfs:label><rdfs:subClassOf rdf:resource="#ObjectCharacteristic"/></owl:Class>
<owl:Class rdf:about="#ConstructionYearFeature"><rdfs:label xml:lang="uk">Ознака року побудови</rdfs:label><rdfs:label xml:lang="en">Construction year feature</rdfs:label><rdfs:subClassOf rdf:resource="#ObjectCharacteristic"/></owl:Class>
<owl:Class rdf:about="#City"><rdfs:label xml:lang="uk">Місто</rdfs:label><rdfs:label xml:lang="en">City</rdfs:label><rdfs:subClassOf rdf:resource="#Location"/></owl:Class>
<owl:Class rdf:about="#Neighborhood"><rdfs:label xml:lang="uk">Район</rdfs:label><rdfs:label xml:lang="en">Neighborhood</rdfs:label><rdfs:subClassOf rdf:resource="#Location"/></owl:Class>
<owl:Class rdf:about="#InfrastructureProximity"><rdfs:label xml:lang="uk">Інфраструктура поруч</rdfs:label><rdfs:label xml:lang="en">Infrastructure proximity</rdfs:label><rdfs:comment xml:lang="uk">Додано під час тестування таксономії (лабораторна №4).</rdfs:comment><rdfs:subClassOf rdf:resource="#Location"/></owl:Class>
<owl:Class rdf:about="#SalePrice"><rdfs:label xml:lang="uk">Ціна продажу</rdfs:label><rdfs:label xml:lang="en">Sale price</rdfs:label><rdfs:subClassOf rdf:resource="#MarketPrice"/></owl:Class>
<owl:Class rdf:about="#RentPrice"><rdfs:label xml:lang="uk">Ціна оренди</rdfs:label><rdfs:label xml:lang="en">Rent price</rdfs:label><rdfs:subClassOf rdf:resource="#MarketPrice"/></owl:Class>
<owl:Class rdf:about="#PricePerSquareMeter"><rdfs:label xml:lang="uk">Ціна за м²</rdfs:label><rdfs:label xml:lang="en">Price per square meter</rdfs:label><rdfs:subClassOf rdf:resource="#MarketPrice"/></owl:Class>
<owl:Class rdf:about="#PriceSegment"><rdfs:label xml:lang="uk">Ціновий сегмент</rdfs:label><rdfs:label xml:lang="en">Price segment</rdfs:label><rdfs:comment xml:lang="uk">Дискретна категорія ціни; цільовий клас у задачі класифікації.</rdfs:comment><rdfs:subClassOf rdf:resource="#MarketPrice"/></owl:Class>
<owl:Class rdf:about="#Buyer"><rdfs:label xml:lang="uk">Покупець</rdfs:label><rdfs:label xml:lang="en">Buyer</rdfs:label><rdfs:subClassOf rdf:resource="#MarketParticipant"/></owl:Class>
<owl:Class rdf:about="#Seller"><rdfs:label xml:lang="uk">Продавець</rdfs:label><rdfs:label xml:lang="en">Seller</rdfs:label><rdfs:subClassOf rdf:resource="#MarketParticipant"/></owl:Class>
<owl:Class rdf:about="#Realtor"><rdfs:label xml:lang="uk">Рієлтор</rdfs:label><rdfs:label xml:lang="en">Realtor</rdfs:label><rdfs:subClassOf rdf:resource="#MarketParticipant"/></owl:Class>
<owl:Class rdf:about="#BankLender"><rdfs:label xml:lang="uk">Банк-кредитор</rdfs:label><rdfs:label xml:lang="en">Bank lender</rdfs:label><rdfs:subClassOf rdf:resource="#MarketParticipant"/></owl:Class>
<owl:Class rdf:about="#PurchaseOrSaleDecision"><rdfs:label xml:lang="uk">Рішення про купівлю або продаж</rdfs:label><rdfs:label xml:lang="en">Purchase or sale decision</rdfs:label><rdfs:subClassOf rdf:resource="#Decision"/></owl:Class>
<owl:Class rdf:about="#MortgageDecision"><rdfs:label xml:lang="uk">Рішення про видачу іпотеки</rdfs:label><rdfs:label xml:lang="en">Mortgage decision</rdfs:label><rdfs:subClassOf rdf:resource="#Decision"/></owl:Class>
<owl:Class rdf:about="#ListingPriceDecision"><rdfs:label xml:lang="uk">Встановлення ціни оголошення</rdfs:label><rdfs:label xml:lang="en">Listing price decision</rdfs:label><rdfs:subClassOf rdf:resource="#Decision"/></owl:Class>
<owl:Class rdf:about="#AutomatedValuationDecision"><rdfs:label xml:lang="uk">Автоматизована оцінка вартості (AVM)</rdfs:label><rdfs:label xml:lang="en">Automated valuation decision</rdfs:label><rdfs:comment xml:lang="uk">Додано під час тестування таксономії (лабораторна №4).</rdfs:comment><rdfs:subClassOf rdf:resource="#Decision"/></owl:Class>
<owl:Class rdf:about="#ListingData"><rdfs:label xml:lang="uk">Оголошення</rdfs:label><rdfs:label xml:lang="en">Listing data</rdfs:label><rdfs:subClassOf rdf:resource="#PropertyDataset"/></owl:Class>
<owl:Class rdf:about="#TransactionData"><rdfs:label xml:lang="uk">Угоди купівлі-продажу</rdfs:label><rdfs:label xml:lang="en">Transaction data</rdfs:label><rdfs:subClassOf rdf:resource="#PropertyDataset"/></owl:Class>
<owl:Class rdf:about="#CadastralData"><rdfs:label xml:lang="uk">Кадастрові дані</rdfs:label><rdfs:label xml:lang="en">Cadastral data</rdfs:label><rdfs:subClassOf rdf:resource="#PropertyDataset"/></owl:Class>
<owl:Class rdf:about="#DataCleaning"><rdfs:label xml:lang="uk">Очищення</rdfs:label><rdfs:label xml:lang="en">Data cleaning</rdfs:label><rdfs:subClassOf rdf:resource="#DataPreparation"/></owl:Class>
<owl:Class rdf:about="#CategoryEncoding"><rdfs:label xml:lang="uk">Кодування категорій</rdfs:label><rdfs:label xml:lang="en">Category encoding</rdfs:label><rdfs:subClassOf rdf:resource="#DataPreparation"/></owl:Class>
<owl:Class rdf:about="#Normalization"><rdfs:label xml:lang="uk">Нормалізація</rdfs:label><rdfs:label xml:lang="en">Normalization</rdfs:label><rdfs:subClassOf rdf:resource="#DataPreparation"/></owl:Class>
<owl:Class rdf:about="#FeatureSelection"><rdfs:label xml:lang="uk">Відбір ознак</rdfs:label><rdfs:label xml:lang="en">Feature selection</rdfs:label><rdfs:subClassOf rdf:resource="#DataPreparation"/></owl:Class>
<owl:Class rdf:about="#PriceSegmentClassificationTask"><rdfs:label xml:lang="uk">Визначення цінового сегмента</rdfs:label><rdfs:label xml:lang="en">Price segment classification task</rdfs:label><rdfs:subClassOf rdf:resource="#ModelingTask"/></owl:Class>
<owl:Class rdf:about="#InvestmentAttractivenessTask"><rdfs:label xml:lang="uk">Оцінювання інвестиційної привабливості</rdfs:label><rdfs:label xml:lang="en">Investment attractiveness task</rdfs:label><rdfs:subClassOf rdf:resource="#ModelingTask"/></owl:Class>
<owl:Class rdf:about="#OverpricedListingDetectionTask"><rdfs:label xml:lang="uk">Виявлення завищених оголошень</rdfs:label><rdfs:label xml:lang="en">Overpriced listing detection task</rdfs:label><rdfs:subClassOf rdf:resource="#ModelingTask"/></owl:Class>
<owl:Class rdf:about="#BinaryClassification"><rdfs:label xml:lang="uk">Бінарна класифікація</rdfs:label><rdfs:label xml:lang="en">Binary classification</rdfs:label><rdfs:subClassOf rdf:resource="#ModelType"/></owl:Class>
<owl:Class rdf:about="#MulticlassClassification"><rdfs:label xml:lang="uk">Багатокласова класифікація</rdfs:label><rdfs:label xml:lang="en">Multiclass classification</rdfs:label><rdfs:subClassOf rdf:resource="#ModelType"/></owl:Class>
<owl:Class rdf:about="#ProbabilisticClassification"><rdfs:label xml:lang="uk">Імовірнісна класифікація</rdfs:label><rdfs:label xml:lang="en">Probabilistic classification</rdfs:label><rdfs:subClassOf rdf:resource="#ModelType"/></owl:Class>
<owl:Class rdf:about="#OrdinalClassification"><rdfs:label xml:lang="uk">Ординальна класифікація</rdfs:label><rdfs:label xml:lang="en">Ordinal classification</rdfs:label><rdfs:comment xml:lang="uk">Додано під час тестування таксономії; класи впорядковані (економ &lt; комфорт &lt; бізнес).</rdfs:comment><rdfs:subClassOf rdf:resource="#MulticlassClassification"/></owl:Class>
<owl:Class rdf:about="#LinearAlgorithm"><rdfs:label xml:lang="uk">Лінійні алгоритми</rdfs:label><rdfs:label xml:lang="en">Linear algorithm</rdfs:label><rdfs:subClassOf rdf:resource="#Algorithm"/></owl:Class>
<owl:Class rdf:about="#TreeAlgorithm"><rdfs:label xml:lang="uk">Алгоритми на основі дерев</rdfs:label><rdfs:label xml:lang="en">Tree-based algorithm</rdfs:label><rdfs:subClassOf rdf:resource="#Algorithm"/></owl:Class>
<owl:Class rdf:about="#EnsembleAlgorithm"><rdfs:label xml:lang="uk">Ансамблеві алгоритми</rdfs:label><rdfs:label xml:lang="en">Ensemble algorithm</rdfs:label><rdfs:subClassOf rdf:resource="#Algorithm"/></owl:Class>
<owl:Class rdf:about="#TrainingSet"><rdfs:label xml:lang="uk">Навчальна вибірка</rdfs:label><rdfs:label xml:lang="en">Training set</rdfs:label><rdfs:subClassOf rdf:resource="#ModelTraining"/></owl:Class>
<owl:Class rdf:about="#TestSet"><rdfs:label xml:lang="uk">Тестова вибірка</rdfs:label><rdfs:label xml:lang="en">Test set</rdfs:label><rdfs:subClassOf rdf:resource="#ModelTraining"/></owl:Class>
<owl:Class rdf:about="#CrossValidationScheme"><rdfs:label xml:lang="uk">Крос-валідація</rdfs:label><rdfs:label xml:lang="en">Cross-validation scheme</rdfs:label><rdfs:subClassOf rdf:resource="#ModelTraining"/></owl:Class>
<owl:Class rdf:about="#TrainedModel"><rdfs:label xml:lang="uk">Навчена модель</rdfs:label><rdfs:label xml:lang="en">Trained model</rdfs:label><rdfs:subClassOf rdf:resource="#Model"/></owl:Class>
<owl:Class rdf:about="#DeployedModel"><rdfs:label xml:lang="uk">Розгорнута модель</rdfs:label><rdfs:label xml:lang="en">Deployed model</rdfs:label><rdfs:comment xml:lang="uk">Навчена модель, впроваджена в роботу.</rdfs:comment><rdfs:subClassOf rdf:resource="#TrainedModel"/><rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#monitoredBy"/><owl:someValuesFrom rdf:resource="#ModelMonitoring"/></owl:Restriction></rdfs:subClassOf><rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#validatedBy"/><owl:someValuesFrom rdf:resource="#ModelValidation"/></owl:Restriction></rdfs:subClassOf></owl:Class>
<owl:Class rdf:about="#ClassificationMetric"><rdfs:label xml:lang="uk">Метрика класифікації</rdfs:label><rdfs:label xml:lang="en">Classification metric</rdfs:label><rdfs:subClassOf rdf:resource="#ModelValidation"/></owl:Class>
<owl:Class rdf:about="#ConfusionMatrix"><rdfs:label xml:lang="uk">Матриця помилок</rdfs:label><rdfs:label xml:lang="en">Confusion matrix</rdfs:label><rdfs:subClassOf rdf:resource="#ModelValidation"/></owl:Class>
<owl:Class rdf:about="#ROCCurve"><rdfs:label xml:lang="uk">ROC-крива</rdfs:label><rdfs:label xml:lang="en">ROC curve</rdfs:label><rdfs:subClassOf rdf:resource="#ModelValidation"/></owl:Class>
<owl:Class rdf:about="#Accuracy"><rdfs:label xml:lang="uk">Accuracy</rdfs:label><rdfs:label xml:lang="en">Accuracy</rdfs:label><rdfs:subClassOf rdf:resource="#ClassificationMetric"/></owl:Class>
<owl:Class rdf:about="#Precision"><rdfs:label xml:lang="uk">Precision</rdfs:label><rdfs:label xml:lang="en">Precision</rdfs:label><rdfs:subClassOf rdf:resource="#ClassificationMetric"/></owl:Class>
<owl:Class rdf:about="#Recall"><rdfs:label xml:lang="uk">Recall</rdfs:label><rdfs:label xml:lang="en">Recall</rdfs:label><rdfs:subClassOf rdf:resource="#ClassificationMetric"/></owl:Class>
<owl:Class rdf:about="#F1Score"><rdfs:label xml:lang="uk">F1</rdfs:label><rdfs:label xml:lang="en">F1 score</rdfs:label><rdfs:subClassOf rdf:resource="#ClassificationMetric"/></owl:Class>
<owl:Class rdf:about="#ROCAUC"><rdfs:label xml:lang="uk">ROC-AUC</rdfs:label><rdfs:label xml:lang="en">ROC-AUC</rdfs:label><rdfs:subClassOf rdf:resource="#ClassificationMetric"/></owl:Class>
<owl:Class rdf:about="#AccuracyKPI"><rdfs:label xml:lang="uk">Показники точності оцінювання</rdfs:label><rdfs:label xml:lang="en">Accuracy KPI</rdfs:label><rdfs:subClassOf rdf:resource="#BusinessKPI"/></owl:Class>
<owl:Class rdf:about="#SpeedKPI"><rdfs:label xml:lang="uk">Показники швидкості</rdfs:label><rdfs:label xml:lang="en">Speed KPI</rdfs:label><rdfs:subClassOf rdf:resource="#BusinessKPI"/></owl:Class>
<owl:Class rdf:about="#RiskKPI"><rdfs:label xml:lang="uk">Показники ризику</rdfs:label><rdfs:label xml:lang="en">Risk KPI</rdfs:label><rdfs:subClassOf rdf:resource="#BusinessKPI"/></owl:Class>
<owl:Class rdf:about="#DataDriftControl"><rdfs:label xml:lang="uk">Контроль дрейфу даних</rdfs:label><rdfs:label xml:lang="en">Data drift control</rdfs:label><rdfs:subClassOf rdf:resource="#ModelMonitoring"/></owl:Class>
<owl:Class rdf:about="#Retraining"><rdfs:label xml:lang="uk">Перенавчання</rdfs:label><rdfs:label xml:lang="en">Retraining</rdfs:label><rdfs:subClassOf rdf:resource="#ModelMonitoring"/></owl:Class>
<owl:Class rdf:about="#DataScientist"><rdfs:label xml:lang="uk">Фахівець з даних</rdfs:label><rdfs:label xml:lang="en">Data scientist</rdfs:label><rdfs:subClassOf rdf:resource="#ModelDeveloper"/></owl:Class>
<owl:Class rdf:about="#MarketAnalyst"><rdfs:label xml:lang="uk">Аналітик ринку нерухомості</rdfs:label><rdfs:label xml:lang="en">Market analyst</rdfs:label><rdfs:subClassOf rdf:resource="#ModelDeveloper"/></owl:Class>
<owl:Class rdf:about="#Model"><rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="#usesAlgorithm"/><owl:someValuesFrom rdf:resource="#Algorithm"/></owl:Restriction></rdfs:subClassOf></owl:Class>
<owl:Class rdf:about="#ClassifiedObject"><rdfs:label xml:lang="uk">Класифікований об’єкт</rdfs:label><rdfs:label xml:lang="en">Classified object</rdfs:label><rdfs:comment xml:lang="uk">Об’єкт нерухомості, якому присвоєно ціновий сегмент.</rdfs:comment><owl:equivalentClass><owl:Class><owl:intersectionOf rdf:parseType="Collection"><owl:Class rdf:about="#RealEstateObject"/><owl:Restriction><owl:onProperty rdf:resource="#hasPriceSegment"/><owl:someValuesFrom rdf:resource="#PriceSegment"/></owl:Restriction></owl:intersectionOf></owl:Class></owl:equivalentClass></owl:Class>
<owl:Class rdf:about="#HighSegmentObject"><rdfs:label xml:lang="uk">Об’єкт високого цінового сегмента</rdfs:label><rdfs:label xml:lang="en">High segment object</rdfs:label><rdfs:comment xml:lang="uk">Об’єкт, що належить до сегмента «високий».</rdfs:comment><owl:equivalentClass><owl:Class><owl:intersectionOf rdf:parseType="Collection"><owl:Class rdf:about="#RealEstateObject"/><owl:Restriction><owl:onProperty rdf:resource="#hasPriceSegment"/><owl:hasValue rdf:resource="#HighSegment"/></owl:Restriction></owl:intersectionOf></owl:Class></owl:equivalentClass></owl:Class>
<owl:Class rdf:about="#EnsembleBasedModel"><rdfs:label xml:lang="uk">Модель на основі ансамблевого алгоритму</rdfs:label><rdfs:label xml:lang="en">Ensemble-based model</rdfs:label><rdfs:comment xml:lang="uk">Модель, що використовує ансамблевий алгоритм.</rdfs:comment><owl:equivalentClass><owl:Class><owl:intersectionOf rdf:parseType="Collection"><owl:Class rdf:about="#Model"/><owl:Restriction><owl:onProperty rdf:resource="#usesAlgorithm"/><owl:someValuesFrom rdf:resource="#EnsembleAlgorithm"/></owl:Restriction></owl:intersectionOf></owl:Class></owl:equivalentClass></owl:Class>
